# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# The Python `lib/`/`build/` rules above are unanchored and would otherwise
# swallow the frontend source dir web/app/lib (taxonomy.ts and filters.ts live
# there). Re-include it.
!web/app/lib/
!web/app/lib/**

# Node
node_modules/
.next/
out/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Timestamped copies taken before editing .env on a deploy host. The bare `.env`
# rule above doesn't cover a suffixed name, so these sat untracked in the
# production checkout.
.env.bak*
.env.*.bak

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Agent tooling — local scratch state, not project source.
# `.claude/` also holds this checkout's git worktrees.
.claude/
.impeccable/

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Database
*.db
*.sqlite
*.sqlite3
# Compressed dumps. The nightly backup service writes into backups/ (which has
# its own .gitignore), but manual pre-deploy dumps land wherever they were run
# from — in practice the repo root on the Pi, where six of them showed up as
# untracked on every `git status` during a deploy.
# Deliberately NOT `*.sql`: the migrations under api/migrations/legacy/,
# infra/postgres/init/ and db_data_export.sql are tracked source.
*.sql.gz

# Logs
logs/
*.log

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# TypeScript incremental build info
*.tsbuildinfo
